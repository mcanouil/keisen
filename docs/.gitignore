/_site/
/.quarto/
**/*.quarto_ipynb

# Generated by _scripts/pre-render.sh, removed by _scripts/post-render.sh:
# changelog.qmd from CHANGELOG.md, _variables.yml from the repository's version.
/changelog.qmd
/_variables.yml

# Cached by _scripts/pre-render.sh from GitHub's own preview card for this
# repository, and kept between renders. See assets/social/README.md.
/assets/social/og-image.png

# A repository root that ignores *.html, as one holding rendered output often
# does, also swallows the six partials atelier ships under _extensions/, which
# carry the skip link and the accessibility scripts. Nothing reports it. The
# files stay on disk, so a local render looks right, while CI clones only what
# is tracked and publishes a site without them.
# This re-includes them. It works because *.html matches files rather than
# directories, so no parent of theirs is excluded; Git will not re-include
# anything inside a directory that is.
!/_extensions/**/*.html
